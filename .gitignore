# ========================================================
# Production .gitignore for React + Vite + TypeScript
# ========================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production Build Outputs
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# Environment Variables & Local Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key

# Logs, Diagnostic & Package Manager Cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.pnpm-store/

# Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Explicitly ensure all public assets (images, audio, vectors) are tracked
!public/
!public/**
!public/images/*
!public/audio/*
!public/assets/*
